
model Semester {
  id        String         @id @default(cuid())
  name      String         @unique
  startDate DateTime
  endDate   DateTime
  status    SemesterStatus @default(UPCOMING)
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  offerings CourseOffering[]

  @@index([status, startDate])
  @@index([deletedAt])
}
