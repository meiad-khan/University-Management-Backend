
model Course {
  id           String    @id @default(cuid())
  code         String    @unique
  title        String
  description  String?
  credits      Int
  departmentId String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department       @relation(fields: [departmentId], references: [id])
  offerings  CourseOffering[]

  @@index([departmentId])
  @@index([title])
  @@index([deletedAt])
}
